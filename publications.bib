}

@article{Shah2026a,
  title = {The {{Double Fire Phenomenon With Alternating Right Bundle Aberrancy}}},
  author = {Shah, Anish S. and Engels, Marc C. and Bunch, T. Jared and Konstantinidis, Klitos},
  date = {2026-07-29},
  journaltitle = {JACC: Case Reports},
  shortjournal = {JACC Case Rep.},
  volume = {31},
  number = {30},
  pages = {108167},
  publisher = {American College of Cardiology Foundation},
  doi = {10.1016/j.jaccas.2026.108167},
  url = {https://www.jacc.org/doi/10.1016/j.jaccas.2026.108167},
  urldate = {2026-07-30},
  abstract = {Background The AV node is a complex structure with multiple outputs into the atria and ventricles, which allows for arrhythmias with multiple patterns of atrial and ventricular relationships. Case Summary A patient with supraventricular tachycardias received ablation for both typical AVNRT through slow pathway modification and orthodromic reciprocating tachycardia through left posteroseptal accessory pathway ablation. Despite this, she continued to have episodes of tachycardia that were symptomatic. Repeat 12-lead ECG demonstrated a regularly irregular tachycardia with both narrow and wide complexes. An electrophysiology study was performed and showed sinus rhythm with dual AV nodal physiology with conduction down both the fast and slow pathways, resulting in double ventricular responses to a single atrial impulse. Additional slow pathway modification was performed, and no further arrhythmias were noted. Discussion Dual AV nodal non-reentrant tachycardia is an uncommon arrhythmia that can occur in patients with dual AV nodal physiology, particularly after slow pathway modification for AVNRT. Take-Home Message Careful evaluation of P wave to QRS relationships on ECG can help elucidate complex patterns of arrhythmia Dual AV nodal non-reentrant tachycardia is an uncommon arrhythmia that can occur in patients with dual AV nodal physiology, particularly after slow pathway modification for AV nodal reentrant tachycardia.},
  keywords = {unread},
  file = {/Users/asshah4/Drive/articles/Shah et al. - 2026 - The Double Fire Phenomenon With Alternating Right Bundle Aberrancy.pdf}
}

